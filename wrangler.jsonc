{
  "name": "zysolves-review",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-26",
  "workers_dev": true,
  "assets": {"directory": "./dist", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": ["/api/*", "/*.html"]},
  "vars": {"DEPLOY_ENV": "preview", "INQUIRIES_ENABLED": "false", "SITE_URL": "https://zysolves.com"},
  "durable_objects": {"bindings": [{"name": "INQUIRY_GUARD", "class_name": "InquiryGuard"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["InquiryGuard"]}],
  "env": {
    "production": {
      "name": "zysolves",
      "workers_dev": false,
      "vars": {"DEPLOY_ENV": "production", "INQUIRIES_ENABLED": "false", "SITE_URL": "https://zysolves.com"},
      "durable_objects": {"bindings": [{"name": "INQUIRY_GUARD", "class_name": "InquiryGuard"}]}
    }
  }
}
